API_URL=http://localhost:8000/api/v1
# Production: use https://mazenkirtasiye.com/api/v1.
# A loopback URL without a port uses NEXT_PUBLIC_API_URL's canonical origin,
# because the production Nginx default virtual host returns 404.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
REVALIDATE_SECRET=
# Next rewrite proxy hedefi (tarayici /api/v1 -> Laravel)
BACKEND_URL=http://localhost:8000
